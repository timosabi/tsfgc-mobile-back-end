{
  "name": "fixture-game-backend",
  "version": "1.0.0",
  "description": "Backend local cu Express + Supabase",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:debug": "npx babel ./src -d ./dist --source-maps",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --runInBand",
    "test:repositories": "jest --runInBand tests/unit/repositories",
    "test:services": "jest --runInBand tests/unit/services",
    "test:e2e": "npm run test:e2e:targeted && npm run test:simulation",
    "test:e2e:targeted": "tsx tests/e2e/friends-group-creation.e2e.spec.ts && tsx tests/e2e/friends-group-joining.e2e.spec.ts && tsx tests/e2e/friends-group-owner-management.e2e.spec.ts && tsx tests/e2e/prediction-slip.e2e.spec.ts && tsx tests/e2e/scoring-leaderboard.e2e.spec.ts && tsx tests/e2e/verbose-flow.e2e.spec.ts",
    "test:simulation": "tsx tests/e2e/cross-group-season-story.e2e.spec.ts",
    "test:season": "tsx tests/e2e/season-simulation.e2e.spec.ts",
    "test:cron": "tsx tests/e2e/active-subscription-hydration.e2e.spec.ts",
    "test:live": "tsx tests/e2e/live-feed.e2e.spec.ts",
    "test:overview": "tsx tests/e2e/matchweek-overview.e2e.spec.ts",
    "test:real-sportmonks": "tsx tests/e2e/real-sportmonks-flow.e2e.spec.ts",
    "test:e2e:types": "tsc --noEmit -p tsconfig.e2e.json",
    "test:all": "npm run build && npm run test:unit && npm run test:e2e:types && npm run test:e2e && npm run test:live && npm run test:cron && npm run test:season && npm run test:overview",
    "seed:scenario:private-group-pending-join": "tsx scripts/create-scenarios/private-group-pending-join.ts",
    "seed:scenario:create-user": "tsx scripts/create-scenarios/create-user.ts",
    "seed:scenario:create-test-group": "tsx scripts/create-scenarios/create-test-group.ts",
    "seed:cleanup": "tsx scripts/create-scenarios/cleanup-dev-seed.ts",
    "lint": "eslint 'src/**/*.{ts,js}' --quiet",
    "format": "prettier --write \"src/**/*.{ts,js,md}\"",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/integrations/supabase/types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.2",
    "@types/express-serve-static-core": "^5.0.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@babel/node": "^7.22.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "babel-node": "^0.0.1-security",
    "dotenv": "^17.2.1",
    "jest": "^30.0.5",
    "nodemon": "^2.0.22",
    "supabase": "^2.98.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=16"
  }
}
